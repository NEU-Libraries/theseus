# v1 (cerberus-classic). Theseus only reads from it.
V1_URL=https://repository.library.northeastern.edu
# A v1 admin's API token (My Loaders -> API Token). Expires after 6 hours.
V1_JWT=

# Record every v1 answer into this folder as it is read (optional). Bodies
# only; the token is never written. Record public objects only.
# THESEUS_V1_RECORD=recordings/demo
# Replay a recording instead of reading v1: no token, no network (optional).
# THESEUS_V1_REPLAY=recordings/demo

# v2 Atlas to write to (0.6.279 or later), and an admin's token from Cerberus.
# Atlas records a v1 pid only for an admin. Theseus finds the v2 root by
# asking Atlas for neu:1.
ATLAS_URL=http://localhost:3001
ATLAS_JWT=

# Where each import writes import_log.csv and the v1 MODS it exported.
# Optional; defaults to runs.
THESEUS_RUN_DIR=runs

# The TUI only (bin/theseus with no arguments). Both optional.
# Cerberus, for the links in the summary.
# CERBERUS_URL=http://localhost:3000
# The pids the prompt offers, with notes for the presenter.
# THESEUS_DEMO_PIDS=demo_pids.yml
