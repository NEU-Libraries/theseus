# v1 (cerberus-classic). Theseus only reads from it.
V1_URL=https://repository.library.northeastern.edu
# A v1 admin's API token (My Loaders -> API Token). Expires after 6 hours.
V1_JWT=

# v2 Atlas to write to, and an admin's or delegated admin's token from Cerberus.
ATLAS_URL=http://localhost:3001
ATLAS_JWT=

# NOID of the v2 root Community that stands in for neu:1.
V2_ROOT=

# The pid -> NOID CSV. Exported MODS is kept in a "mods" folder beside it.
THESEUS_MAP=runs/theseus_map.csv
